
import discord
from discord.ext import commands
from discord import app_commands
import asyncio
import time

TOKEN = "YOUR_NEW_BOT_TOKEN"
INVITE = "https://discord.gg/7eUAujTK"

intents = discord.Intents.default()
bot = commands.Bot(command_prefix="?", intents=intents)

cooldowns = {}

@bot.event
async def on_ready():
    await bot.tree.sync()
    print(f"Ad Bot Online: {bot.user}")

@bot.tree.command(name="adspam", description="Send an advertisement batch")
@app_commands.checks.cooldown(1, 10)
async def adspam(interaction: discord.Interaction):

    await interaction.response.send_message(
        "🔥 Advertisement batch started!",
        ephemeral=True
    )

    for i in range(10):
        await interaction.channel.send(
            f"🔥 JOIN US TODAY! 🔥\n{INVITE}",
            allowed_mentions=discord.AllowedMentions.none()
        )
        await asyncio.sleep(2)

@adspam.error
async def adspam_error(interaction, error):
    if isinstance(error, app_commands.CommandOnCooldown):
        await interaction.response.send_message(
            f"Try again in {error.retry_after:.1f} seconds.",
            ephemeral=True
        )

bot.run(TOKEN)
